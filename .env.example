# Local development configuration
# For deployment, these are set via Terraform / the deploy command.

# Vertex AI Configuration (default)
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global

# Alternatively, for Gemini API via Google AI Studio,
# comment out the three lines above and uncomment:
# GEMINI_API_KEY=your-api-key-here

# --- Membership draft workflow -------------------------------------------
# The guest registration sheet and the tab within it.
SPREADSHEET_ID=
SHEET_NAME=Form responses 1

# Registrations before this date are ignored entirely, so historic rows never
# need a manual "processed" backfill. This was the n8n go-live date.
PROCESS_ROWS_AFTER=2026-08-12

# How the sheet renders the Timestamp column. DMY for a German-locale sheet
# (05/08/2026 = 5 August). Check an actual cell before trusting this.
DATE_ORDER=DMY

TIMEZONE=Europe/Berlin
SLACK_CHANNEL=#cbt-clubops-admin

# Fee rules. Parameters, not constants — changing a rate must never require a
# code change. See docs/CBT_application_form_2026_fees_v2.pdf.
STANDARD_MONTHLY_FEE=21
REDUCED_MONTHLY_FEE=14.5
APPLICATION_FEE=25
CURRENT_MONTH_CUTOFF_DAY=10

# true = compute and log, but create no draft, write no cell, post no message.
DRY_RUN=true

# --- Club details --------------------------------------------------------
# Where fees go and who signs the letter. Not secrets — a guest is given the
# IBAN — but a named person's account and a named person's signature, and this
# repository is public, so they are configuration rather than code.
#
# Leave them blank and the letter renders obvious placeholders
# (DE00 0000..., "Club Treasurer"). That is the deliberate safe failure: a guest
# who receives one asks what it is instead of paying the wrong person.
BANK_IBAN=
BANK_BIC=
BANK_NAME=
BANK_OWNER=
SIGNATURE_NAME=

# --- Secrets --------------------------------------------------------------
# On Cloud Run these come from Secret Manager via --set-secrets. Locally, fill
# them in .env (which is gitignored) — never commit real values.
# Mint the refresh token with: uv run python scripts/mint_refresh_token.py
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
SLACK_BOT_TOKEN=

# --- PandaDoc application documents ---
# Only needed for POST /jobs/application-document and
# scripts/create_application_doc.py. Left blank the twice-weekly email job still
# runs; the document job refuses with a clear error.
PANDADOC_API_KEY=
# The form's second required signature. Defaults to the club address printed on
# the form itself, so it only needs setting if somebody else countersigns.
PANDADOC_OFFICER_EMAIL=
PANDADOC_OFFICER_NAME=

# --- Slack relay (the public service, membership.slack_web:app) -----------
# Only for the /application-doc slash command. The twice-weekly email job needs
# none of these; the relay in turn needs none of the variables above except
# SLACK_BOT_TOKEN. That separation is deliberate — see docs/SLACK.md.
#
# Basic Information -> App Credentials -> Signing Secret. Not the bot token.
SLACK_SIGNING_SECRET=
# A channel *id* (C0123456789), not "#cbt-clubops-admin": the members lookup
# takes only ids. Right-click the channel -> View channel details -> bottom.
# Whoever is in this channel is who may run the command.
SLACK_ADMIN_CHANNEL_ID=
# The private service (cbt-clubops): base URL, no trailing path. Also the
# audience the relay's ID token is minted for.
CORE_SERVICE_URL=
