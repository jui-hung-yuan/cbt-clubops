*-key.json
credentials*.json

# Terraform. The existing ".terraform*" rule above covers the plugin cache but
# not these: state records the whole deployment, and tfvars carries the image
# tag and channel id. Neither belongs in the repo.
terraform/*.tfstate
terraform/*.tfstate.*
terraform/*.tfvars
terraform/crash.log
# ...but the lock file should be committed, so provider versions are the same
# for whoever applies next.
!terraform/.terraform.lock.hcl

# Any .env, at any depth — not just the one at the root. n8n/.env holds the
# credentials the original workflow used and is real: gitleaks found three live
# secrets in it. The bare ".env" rule above does not match a nested path.
**/.env
**/.env.*
!**/.env.example

# The n8n workflow this service replaced. Kept locally as the fallback, not
# committed: the exported JSON has the club's bank details, the treasurer's
# name and the spreadsheet id hard-coded in its Code nodes.
n8n/
